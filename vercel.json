{
  "buildCommand": "npm install && NODE_OPTIONS='--max-old-space-size=4096' npm run build --prefix apps/web && node apps/web/tools/inject-seo.cjs",
  "outputDirectory": "dist/apps/web",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/quote",
      "permanent": true
    },
    {
      "source": "/dp/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/dp/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}