# Express API port
PORT=3001

# CORS — set to your frontend domain in production
CORS_ORIGIN=https://scoopychatt.com

# PocketBase service URL (set to your Railway PocketBase service URL)
POCKETBASE_URL=http://localhost:8090

# PocketBase superuser credentials
PB_SUPERUSER_EMAIL=your-admin@email.com
PB_SUPERUSER_PASSWORD=your-strong-password

# Google APIs
GOOGLE_PLACES_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Jobber — from developer.getjobber.com/apps ("Scoopy Doo Mission Control")
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Must exactly match the Callback URL saved on the Jobber app
JOBBER_REDIRECT_URI=https://scoopychatt-production.up.railway.app/jobber-oauth/callback
JOBBER_API_VERSION=2025-04-16
# Long random string. Gates /jobber-oauth/start and POST /jobber-api/graphql.
JOBBER_INTERNAL_SECRET=
